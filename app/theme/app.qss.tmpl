/* ============================================================================
 * 「伯爵大光圈」QSS 模板
 * ----------------------------------------------------------------------------
 * 风格：浅色纸面 + 红/蓝点缀 + 圆角卡片 + 细线（参考 RE:VOLUTION 式编辑排版）。
 * 本文件只写"结构与状态"，颜色/尺寸一律来自 app/theme/tokens.py 的令牌。
 * 基础配色走 QPalette，QSS 只负责形状、间距与交互状态。
 * ==========================================================================*/

/* ---------- 根 ---------- */

QMainWindow, QDialog { background: {{color.bg.root}}; }

QToolTip {
    background: {{color.bg.tooltip}};
    color: {{color.text.on.dark}};
    border: none;
    border-radius: {{radius.sm}}px;
    padding: {{space.2}}px {{space.3}}px;
    font-size: {{font.size.caption}}px;
}

/* ---------- 文字角色 ---------- */

QLabel { background: transparent; color: {{color.text.primary}}; }
QLabel[role="title"]   { font-size: {{font.size.title}}px; font-weight: {{font.weight.bold}}; color: {{color.text.primary}}; }
QLabel[role="section"] { font-size: {{font.size.section}}px; font-weight: {{font.weight.semibold}}; color: {{color.text.primary}}; }
QLabel[role="hint"]    { font-size: {{font.size.caption}}px; color: {{color.text.muted}}; }
QLabel[role="value"]   { font-size: {{font.size.bodyLg}}px; font-weight: {{font.weight.medium}}; color: {{color.text.secondary}}; }
QLabel[role="status"]  { font-size: {{font.size.caption}}px; color: {{color.text.muted}}; }

/* 标题下的品牌色短线 */
#AccentBar {
    background: {{color.accent}};
    border: none;
    border-radius: 2px;
}

/* 一条细线，用于分区 */
QFrame[role="rule"] {
    background: {{color.border.subtle}};
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* ---------- 画布 ---------- */

#PreviewSurface, #CanvasFrame {
    background: {{color.bg.canvas}};
    color: {{color.text.muted}};
    border: 1px solid {{color.border.subtle}};
    border-radius: {{radius.lg}}px;
}
/* 拖拽悬停：红色虚线框 + 淡红底 */
#PreviewSurface[drag="true"] {
    background: {{color.accent.soft}};
    border: 2px dashed {{color.accent}};
}

/* ---------- 卡片：QGroupBox 当作白底圆角卡片 ---------- */

QGroupBox {
    background: {{color.bg.panel}};
    border: 1px solid {{color.border.subtle}};
    border-radius: {{radius.lg}}px;
    margin-top: 0px;
    padding: 34px {{space.5}}px {{space.5}}px {{space.5}}px;
    font-weight: {{font.weight.semibold}};
}
/* 拖动中的卡片：边框直接变红（改组件自身，不叠覆盖层） */
QGroupBox[drag="true"] {
    border: 1px solid {{color.accent}};
}
QGroupBox[drag="true"]::title {
    color: {{color.accent.ink}};
}

QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: {{space.5}}px;
    top: {{space.4}}px;
    padding: 0px;
    color: {{color.text.primary}};
    font-size: {{font.size.section}}px;
    font-weight: {{font.weight.semibold}};
}

QFrame[role="card"] {
    background: {{color.bg.panel}};
    border: 1px solid {{color.border.subtle}};
    border-radius: {{radius.lg}}px;
}

/* ---------- 按钮 ---------- */

QPushButton {
    background: {{color.bg.panel}};
    color: {{color.text.primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
    padding: {{space.1}}px {{control.padding.x}}px;
    min-height: {{control.height}}px;
}
QPushButton:hover  { background: {{color.bg.control.hover}}; border-color: {{color.border.hover}}; }
QPushButton:pressed { background: {{color.bg.control.active}}; }
QPushButton:focus  { border: {{control.focus.width}}px solid {{color.focus.ring}}; }
QPushButton:disabled {
    background: {{color.bg.control}};
    color: {{color.text.disabled}};
    border-color: {{color.border.subtle}};
}

#BrandLogo {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
    border-radius: {{radius.sm}}px;
}
#BrandLogo:hover { background: {{color.accent.soft}}; }
#BrandLogo:focus { border: 1px solid {{color.focus.ring}}; }

/* 主操作：黑底白字粗体胶囊（参考图 NEXT 按钮），整屏只允许一个 */
QPushButton[variant="primary"] {
    background: {{color.solid}};
    color: {{color.on.solid}};
    border: none;
    border-radius: {{radius.pill}}px;
    padding: {{space.1}}px {{space.6}}px;
    min-height: {{control.height}}px;
    font-weight: {{font.weight.bold}};
}
QPushButton[variant="primary"]:hover   { background: {{color.solid.hover}}; }
QPushButton[variant="primary"]:pressed { background: {{color.solid.active}}; }
QPushButton[variant="primary"]:focus   { border: {{control.focus.width}}px solid {{color.accent}}; }
QPushButton[variant="primary"]:disabled {
    background: {{color.bg.control}};
    color: {{color.text.disabled}};
    border: none;
}

/* 次级强调：红描边（面板内的重要动作） */
QPushButton[variant="accent"] {
    background: {{color.bg.panel}};
    color: {{color.accent.ink}};
    border: 1px solid {{color.accent}};
    font-weight: {{font.weight.semibold}};
}
QPushButton[variant="accent"]:hover   { background: {{color.accent.soft}}; border-color: {{color.accent.hover}}; }
QPushButton[variant="accent"]:pressed { background: {{color.accent.soft}}; border-color: {{color.accent.active}}; }
QPushButton[variant="accent"]:disabled { color: {{color.text.disabled}}; border-color: {{color.border.subtle}}; }

/* 幽灵按钮：只留描边 */
QPushButton[variant="ghost"] {
    background: transparent;
    border: 1px solid {{color.border}};
}
QPushButton[variant="ghost"]:hover { background: {{color.bg.control.hover}}; border-color: {{color.accent}}; color: {{color.accent.ink}}; }

/* 导入图片：黑底白字粗体胶囊（和主操作同形） */
QPushButton[variant="warm"] {
    background: {{color.solid}};
    color: {{color.on.solid}};
    border: none;
    border-radius: {{radius.pill}}px;
    padding: {{space.1}}px {{space.6}}px;
    min-height: {{control.height}}px;
    font-weight: {{font.weight.bold}};
}
QPushButton[variant="warm"]:hover   { background: {{color.solid.hover}}; }
QPushButton[variant="warm"]:pressed { background: {{color.solid.active}}; }
QPushButton[variant="warm"]:focus   { border: {{control.focus.width}}px solid {{color.accent}}; }

/* 可切换按钮（显示原图） */
QPushButton:checked {
    background: {{color.text.primary}};
    color: {{color.bg.root}};
    border-color: {{color.text.primary}};
    font-weight: {{font.weight.semibold}};
}

/* ---------- 下拉框 ---------- */

QComboBox {
    background: {{color.bg.panel}};
    color: {{color.text.primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
    padding: {{space.2}}px 32px {{space.2}}px {{control.padding.x}}px;
    min-height: {{control.height}}px;
}
QComboBox:hover { border-color: {{color.border.hover}}; }
QComboBox:focus { border: {{control.focus.width}}px solid {{color.focus.ring}}; }
QComboBox:disabled { color: {{color.text.disabled}}; border-color: {{color.border.subtle}}; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow { image: url({{asset.chevron}}); width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background: {{color.bg.panel}};
    color: {{color.text.primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
    padding: {{space.2}}px;
    selection-background-color: {{color.accent.soft}};
    selection-color: {{color.accent.ink}};
    outline: 0;
}

/* ---------- 滑块 ---------- */

QSlider { min-height: {{control.height}}px; background: transparent; }
QSlider::groove:horizontal {
    height: {{control.slider.groove}}px;
    background: {{color.border.subtle}};
    border-radius: {{space.1}}px;
}
QSlider::sub-page:horizontal {
    background: {{color.accent}};
    border-radius: {{space.1}}px;
}
QSlider::handle:horizontal {
    width: {{control.slider.handle}}px;
    height: {{control.slider.handle}}px;
    margin: -7px 0;
    border-radius: 8px;
    background: {{color.bg.panel}};
    border: 2px solid {{color.accent}};
}
QSlider::handle:horizontal:hover { border-color: {{color.accent.hover}}; background: {{color.accent.soft}}; }

/* ---------- 勾选 ---------- */

QCheckBox { spacing: {{space.3}}px; color: {{color.text.primary}}; }
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    background: {{color.bg.panel}};
}
QCheckBox::indicator:hover { border-color: {{color.accent}}; }
QCheckBox::indicator:checked {
    background: {{color.accent}};
    border-color: {{color.accent}};
    image: url({{asset.check}});
}

/* ---------- 分隔器 ---------- */

QSplitter::handle { background: {{color.border.subtle}}; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background: {{color.accent}}; }

/* ---------- 状态栏 ---------- */

QStatusBar {
    background: {{color.bg.root}};
    color: {{color.text.muted}};
    border-top: 1px solid {{color.border.subtle}};
    font-size: {{font.size.caption}}px;
}
QStatusBar::item { border: none; }

/* ---------- 滚动条 ---------- */

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical {
    background: {{color.border}};
    border-radius: 5px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover { background: {{color.accent}}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: {{color.border}}; border-radius: 5px; min-width: 32px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- 输入框 ---------- */

QLineEdit {
    background: {{color.bg.panel}};
    color: {{color.text.primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
    padding: {{space.2}}px {{control.padding.x}}px;
    min-height: {{control.height}}px;
    selection-background-color: {{color.accent}};
    selection-color: {{color.on.accent}};
}
QLineEdit:focus { border: {{control.focus.width}}px solid {{color.focus.ring}}; }

QSpinBox#LensValue, QDoubleSpinBox#LensValue {
    background: {{color.bg.panel}};
    color: {{color.text.primary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
    padding: 2px 6px;
    min-height: 22px;
}
QSpinBox#LensValue:focus, QDoubleSpinBox#LensValue:focus { border: 1px solid {{color.focus.ring}}; }
QSpinBox#LensValue::up-button, QSpinBox#LensValue::down-button,
QDoubleSpinBox#LensValue::up-button, QDoubleSpinBox#LensValue::down-button {
    width: 0;
    height: 0;
    border: none;
}
QSpinBox#LensValue QLineEdit, QDoubleSpinBox#LensValue QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}
